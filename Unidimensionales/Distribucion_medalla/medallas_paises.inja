{# Distribucion de tipos de medalla desde data.json #}

{% set margin = obj("top", 55, "right", 40, "bottom", 70, "left", 85) %}
{% set width = 680 - margin.left - margin.right %}
{% set height = 500 - margin.top - margin.bottom %}


<svg width="{{ width + margin.left + margin.right }}"
     height="{{ height + margin.top + margin.bottom }}"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:v="https://odviz.org/1.0/">

  <style>
    .title { font-family: Arial, sans-serif; font-size: 21px; font-weight: 700; }
    .axis-label { font-family: Arial, sans-serif; font-size: 16px; fill: #000; }
    .tick-label { font-family: Arial, sans-serif; font-size: 12px; fill: #222; }
    .axis-line, .tick-line { stroke: #e5e5e5; }
    .grid-line { stroke: #e5e5e5; }
  </style>

  <text class="title"
        x="{{ (width + margin.left + margin.right) / 2 }}"
        y="26"
        text-anchor="middle">Distribución de tipos de medalla</text>

  <g transform="translate({{ margin.left }},{{ margin.top }})">

    {% set medalTypes = ["Gold", "Silver", "Bronze"] %}
    {% set medalGroups = data | regroup("Medal") %}
    {% set y = scaleLinear()
          | domain([0, 15000])
          | range(height, 0) %}
    {% set x = scaleBand()
          | range(0, width)
          | domain(medalTypes)
          | padding(0.4) %}

    <g transform="translate(0,{{ height }})">
      {{ call(axisBottom(x) | tickValues(medalTypes)) }}
    </g>

    <g>
      {{ call(axisLeft(y) | tickValues([0, 5000, 10000, 15000]) | grid(true)) }}
    </g>

    <text class="axis-label"
          x="{{ width / 2 }}"
          y="{{ height + 52 }}"
          text-anchor="middle">Tipo de medalla</text>

    <text class="axis-label"
          x="-42"
          y="{{ height / 2 }}"
          text-anchor="middle">Cantidad</text>

    {% for medal in medalTypes %}
      {% for group in medalGroups %}
        {% if group.grouper == medal %}
          <rect id="sh-medalla-{{ medal }}" href="#row-medalla-{{ medal }}"
                x="{{ scale(x, medal) }}"
                y="{{ scale(y, group.list | length) }}"
                width="{{ bandwidth(x) }}"
                height="{{ height - scale(y, group.list | length) }}"
                fill="#69b3a2"/>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </g>

  <v:table name="distribucion_medallas" columns="medalla,cantidad" visualization="chart">


      {% for medal in medalTypes %}
        {% for group in medalGroups %}
          {% if group.grouper == medal %}

            <v:row id="row-medalla-{{ medal }}" href="#sh-medalla-{{ medal }}">

            {{ medal }},{{ group.list | length }}

            </v:row>
  
          {% endif %}
        {% endfor %}
      {% endfor %}

  </v:table>
</svg>
